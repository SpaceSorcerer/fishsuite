{
  "workbook": {
    "title": "MIAT×QKI exact-footprint single-z analysis",
    "subtitle": "Publication and dissertation review workbook",
    "purpose": "Consolidate the final exact-footprint postrun tables without altering source measurements.",
    "interpretationGuard": "Exact-footprint spatial association is an imaging measurement; this workbook does not test direct molecular binding.",
    "analysisConvention": "One reviewed z plane per FOV, shared by DAPI, MIAT, and QKI; no projection is used for colocalization quantitation.",
    "provenance": "Source tables are copied or pivoted without changing cell values. Derived summary, control, representative-path, and audit rows are labeled.",
    "freezePanes": false,
    "summaryPreviewLastColumn": "Y",
    "readmeNotes": [
      "Primary displayed endpoint p-values are sampled-primary, full-cohort, exact within-slide permutation p-values.",
      "Welch and slide-adjusted results remain available in the inference worksheets.",
      "q95 is primary; q90 and q99 are sensitivity thresholds.",
      "The q95 usable-spot fraction must be read beside the conservative all-floor fraction and null-usability coverage.",
      "NT and KD biological sets are independent; replicate numbers are not pairing keys.",
      "Secondary-only controls are QC-only and excluded from biological inference.",
      "The 707,446-row footprint-pixel table remains in its canonical gz CSV; path, hash, and omission reason are in Sampling Audit."
    ]
  },
  "summaryTableKey": "summary",
  "tables": [
    {
      "key": "summary",
      "file": "summary.csv",
      "sheet": "Summary",
      "tableName": "SummaryTable",
      "description": "Selected sampled-primary full-cohort endpoints and q95 associated/global ratio-of-ratios contrasts.",
      "required": true,
      "requiredColumns": [
        "section", "result", "mean_nt", "mean_kd", "kd_over_nt",
        "percent_change_kd_vs_nt", "primary_exact_permutation_p",
        "ratio_of_ratios", "ratio_of_ratios_ci95_low", "ratio_of_ratios_ci95_high",
        "ratio_of_ratios_p_two_sided", "note"
      ],
      "columns": {
        "section": {"type": "text", "role": "result group", "definition": "Summary section."},
        "result": {"type": "text", "role": "result label", "definition": "Neutral observation-first result label."},
        "mean_nt": {"type": "number", "role": "set-level mean", "definition": "Mean across independent NT biological sets."},
        "mean_kd": {"type": "number", "role": "set-level mean", "definition": "Mean across independent MIAT-KD biological sets."},
        "kd_over_nt": {"type": "number", "role": "effect", "definition": "KD divided by NT."},
        "percent_change_kd_vs_nt": {"type": "percent_points", "numberFormat": "0.00\"%\"", "role": "effect", "definition": "KD-versus-NT percent change, stored in percentage-point units."},
        "primary_exact_permutation_p": {"type": "pvalue", "role": "primary inference", "definition": "Sampled-primary full-cohort exact within-slide permutation p-value."},
        "ratio_of_ratios": {"type": "number", "role": "contrast", "definition": "Associated KD/NT ratio divided by global KD/NT ratio."},
        "ratio_of_ratios_ci95_low": {"type": "number", "role": "confidence interval", "definition": "Lower 95% confidence limit for ratio of ratios."},
        "ratio_of_ratios_ci95_high": {"type": "number", "role": "confidence interval", "definition": "Upper 95% confidence limit for ratio of ratios."},
        "ratio_of_ratios_p_two_sided": {"type": "pvalue", "role": "ratio inference", "definition": "Two-sided p-value for the ratio-of-ratios contrast."},
        "note": {"type": "text", "role": "interpretation guard", "definition": "Neutral interpretation note and denominator caveat."}
      }
    },
    {
      "key": "spots",
      "file": "corrected_spots_exact.csv",
      "sheet": "Spots Exact",
      "tableName": "SpotsExactTable",
      "description": "All 23,829 corrected per-spot exact-footprint records; every source column is retained.",
      "required": true,
      "requiredColumns": [
        "spot_uid", "image_key", "nucleus_uid", "selected_z_1based",
        "quantitation_plane", "footprint_area_px", "qki_footprint_mean_raw",
        "qki_threshold_positive_q95", "null_usable", "eligible_for_sampling",
        "sampled_in_analysis", "sampling_metadata_source"
      ],
      "compactStyle": true,
      "writeChunkRows": 250
    },
    {
      "key": "nucleus",
      "file": "nucleus_endpoints.csv",
      "sheet": "Nucleus Endpoints",
      "tableName": "NucleusEndpointTable",
